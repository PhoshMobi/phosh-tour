#: data/mobi.phosh.PhoshTour.metainfo.xml.in.in:9
msgid "This apps introduces you to your device via a small graphical tour."
msgstr ""
"An app ma komendya ty dhe dha devis ow devnydhya unn torn byghan grafegel."

